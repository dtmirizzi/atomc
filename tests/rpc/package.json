{
  "name": "@atomc/rpc-contract-tests",
  "version": "0.0.1",
  "private": true,
  "description": "Real daemon + TypeScript client JSON-RPC contract tests for atomc (docs/architecture/contracts/rpc.md)",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build:deps": "pnpm --filter @atomc/daemon-client build && pnpm --filter @atomc/core-ir build",
    "precontract": "pnpm run build:deps",
    "contract": "vitest run",
    "pretest": "pnpm run build:deps",
    "test": "vitest run",
    "pretypecheck": "pnpm run build:deps",
    "typecheck": "tsc --noEmit",
    "lint": "biome check ts vitest.config.ts"
  },
  "dependencies": {
    "@atomc/daemon-client": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "ws": "catalog:"
  }
}
