{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dtmirizzi.github.io/atomc/schema/system_ir.schema.json",
  "title": "atomc SystemIR (placeholder)",
  "description": "PLACEHOLDER schema for the docs schema browser. The real schema is generated by packages/core-ir/python and copied to docs/public/schema/system_ir.schema.json by scripts/sync.mjs. This file is only used when that generated schema is absent.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "meta"],
  "properties": {
    "schema_version": { "type": "string", "description": "IR schema semver, currently 0.1.0." },
    "meta": { "$ref": "#/$defs/Meta" },
    "electrical": { "$ref": "#/$defs/Electrical" },
    "layout": { "$ref": "#/$defs/Layout" },
    "keyboard": { "$ref": "#/$defs/Keyboard" },
    "firmware": { "$ref": "#/$defs/Firmware" },
    "simulation": { "$ref": "#/$defs/Simulation" },
    "mechanical": { "$ref": "#/$defs/Mechanical" },
    "sourcing": { "$ref": "#/$defs/Sourcing" },
    "fabrication": { "$ref": "#/$defs/Fabrication" },
    "orders": { "$ref": "#/$defs/Orders" },
    "gates": { "$ref": "#/$defs/Gates" },
    "provenance": { "$ref": "#/$defs/Provenance" },
    "ext": { "type": "object", "description": "Plugin extension point keyed by plugin name." }
  },
  "$defs": {
    "Meta": {
      "type": "object",
      "description": "Document metadata. Document rev increments on every successful transaction.",
      "additionalProperties": false,
      "required": ["project_id", "name", "rev"],
      "properties": {
        "project_id": { "type": "string", "description": "Stable project id, e.g. proj:atomc-keeb." },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time", "description": "RFC 3339 UTC." },
        "modified_at": { "type": "string", "format": "date-time" },
        "rev": { "type": "integer", "description": "Document revision counter." },
        "atomc_version": { "type": "string" }
      }
    },
    "NodeMeta": {
      "type": "object",
      "description": "Per-node concurrency fields (present on every top-level domain node).",
      "properties": {
        "rev": { "type": "integer", "description": "Document rev at which this node last changed." },
        "lock": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/Lock" }],
          "description": "Active holder lock, or null."
        }
      }
    },
    "Lock": {
      "type": "object",
      "properties": {
        "holder": { "type": "string", "description": "agent:<name>#<session-seq>." },
        "acquired_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "reason": { "type": "string" }
      }
    },
    "Electrical": {
      "type": "object",
      "description": "Circuits: modules, components, nets, assertions and ERC results (owned by plugin-atopile).",
      "properties": {
        "_meta": { "$ref": "#/$defs/NodeMeta" },
        "source": { "type": "object", "description": "atopile entry point, e.g. main.ato:App." },
        "components": { "type": "array", "items": { "$ref": "#/$defs/Component" } },
        "nets": { "type": "array", "items": { "$ref": "#/$defs/Net" } },
        "assertions": { "type": "array", "items": { "$ref": "#/$defs/Assertion" } },
        "erc": { "type": "array", "items": { "$ref": "#/$defs/ErcViolation" } }
      }
    },
    "Component": {
      "type": "object",
      "required": ["id", "designator"],
      "properties": {
        "id": { "type": "string", "description": "comp:<slug>, e.g. comp:U1." },
        "designator": { "type": "string", "description": "Schematic reference, e.g. U1." },
        "mpn": { "type": "string" },
        "manufacturer": { "type": "string" },
        "value": { "type": "string" },
        "footprint": { "type": "string" },
        "lcsc": { "type": "string", "description": "LCSC part number, e.g. C12345." },
        "dnp": { "type": "boolean" },
        "attributes": { "type": "object" },
        "pins": { "type": "array", "items": { "$ref": "#/$defs/Pin" } }
      }
    },
    "Pin": {
      "type": "object",
      "required": ["number"],
      "properties": {
        "number": { "type": "string" },
        "name": { "type": "string" },
        "net_ref": { "type": "string", "description": "net:<slug>." }
      }
    },
    "Net": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "class": { "enum": ["power", "ground", "signal", "diff", "usb", "other"] },
        "voltage_v": { "type": "number" }
      }
    },
    "Assertion": {
      "type": "object",
      "required": ["id", "expr", "status"],
      "properties": {
        "id": { "type": "string" },
        "expr": { "type": "string" },
        "status": { "enum": ["pass", "fail", "unknown"] },
        "message": { "type": "string" }
      }
    },
    "ErcViolation": {
      "type": "object",
      "required": ["id", "rule", "severity", "message"],
      "properties": {
        "id": { "type": "string" },
        "rule": { "type": "string" },
        "severity": { "enum": ["error", "warning"] },
        "message": { "type": "string" },
        "refs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "Layout": {
      "type": "object",
      "description": "Board outline, placements and test pads (parse of a .kicad_pcb via kiutils).",
      "properties": {
        "_meta": { "$ref": "#/$defs/NodeMeta" },
        "source": { "type": "object" },
        "outline": { "$ref": "#/$defs/Outline" },
        "layers": { "type": "integer" },
        "placements": { "type": "array", "items": { "$ref": "#/$defs/Placement" } },
        "test_pads": { "type": "array", "items": { "$ref": "#/$defs/TestPad" } },
        "mounting_holes": { "type": "array", "items": { "$ref": "#/$defs/Hole" } },
        "keepouts": { "type": "array", "items": { "$ref": "#/$defs/Keepout" } }
      }
    },
    "Outline": {
      "type": "object",
      "properties": {
        "polygon": {
          "type": "array",
          "description": "Closed polygon in mm, board frame, origin = bottom-left of bbox.",
          "items": { "type": "array", "items": { "type": "number" } }
        },
        "thickness_mm": { "type": "number" }
      }
    },
    "Placement": {
      "type": "object",
      "required": ["component_ref", "x", "y", "side"],
      "properties": {
        "component_ref": { "type": "string" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "rotation_deg": { "type": "number" },
        "side": { "enum": ["top", "bottom"] }
      }
    },
    "TestPad": {
      "type": "object",
      "required": ["id", "net_ref", "x", "y", "side"],
      "properties": {
        "id": { "type": "string", "description": "pad:<slug>, e.g. pad:TP_SWDIO." },
        "net_ref": { "type": "string" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "side": { "enum": ["top", "bottom"] },
        "diameter_mm": { "type": "number" },
        "kind": { "enum": ["pogo", "edge", "tag_connect"] },
        "label": { "type": "string" }
      }
    },
    "Hole": {
      "type": "object",
      "required": ["id", "x", "y", "diameter_mm"],
      "properties": {
        "id": { "type": "string" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "diameter_mm": { "type": "number" },
        "plated": { "type": "boolean" }
      }
    },
    "Keepout": {
      "type": "object",
      "required": ["id", "polygon", "side", "kind"],
      "properties": {
        "id": { "type": "string" },
        "polygon": { "type": "array", "items": { "type": "array", "items": { "type": "number" } } },
        "side": { "enum": ["top", "bottom"] },
        "kind": { "enum": ["component", "copper", "pogo"] }
      }
    },
    "Keyboard": {
      "type": "object",
      "description": "Optional keyboard domain node — source for QMK keyboard.json, plate cutouts and Renode key injection.",
      "properties": {
        "_meta": { "$ref": "#/$defs/NodeMeta" },
        "matrix": { "$ref": "#/$defs/Matrix" },
        "keys": { "type": "array", "items": { "$ref": "#/$defs/Key" } },
        "usb": { "$ref": "#/$defs/Usb" },
        "qmk": { "$ref": "#/$defs/Qmk" }
      }
    },
    "Matrix": {
      "type": "object",
      "required": ["rows", "cols", "diode_direction", "row_pins", "col_pins"],
      "properties": {
        "rows": { "type": "integer" },
        "cols": { "type": "integer" },
        "diode_direction": { "enum": ["COL2ROW", "ROW2COL"] },
        "row_pins": { "type": "array", "items": { "type": "string" } },
        "col_pins": { "type": "array", "items": { "type": "string" } }
      }
    },
    "Key": {
      "type": "object",
      "required": ["id", "row", "col", "x_u", "y_u"],
      "properties": {
        "id": { "type": "string", "description": "key:<slug>, e.g. key:K0_3." },
        "row": { "type": "integer" },
        "col": { "type": "integer" },
        "x_u": { "type": "number", "description": "Key units (1u = 19.05 mm)." },
        "y_u": { "type": "number" },
        "w_u": { "type": "number" },
        "h_u": { "type": "number" },
        "rotation_deg": { "type": "number" },
        "switch_ref": { "type": "string" },
        "diode_ref": { "type": "string" },
        "label": { "type": "string" },
        "keycode_default": { "type": "string", "description": "QMK keycode, e.g. KC_A." }
      }
    },
    "Usb": {
      "type": "object",
      "properties": {
        "vid": { "type": "string" },
        "pid": { "type": "string" },
        "manufacturer": { "type": "string" },
        "product": { "type": "string" },
        "device_version": { "type": "string" }
      }
    },
    "Qmk": {
      "type": "object",
      "properties": {
        "keyboard_path": { "type": "string", "description": "e.g. atomc/keeb." },
        "bootloader": { "type": "string" },
        "processor": { "type": "string" },
        "board": { "type": "string" }
      }
    },
    "Firmware": {
      "type": "object",
      "description": "Firmware targets, peripheral maps and test suites (owned by plugin-renode / plugin-qmk).",
      "properties": {
        "_meta": { "$ref": "#/$defs/NodeMeta" },
        "targets": { "type": "array", "items": { "$ref": "#/$defs/FwTarget" } },
        "peripherals": { "type": "array", "items": { "$ref": "#/$defs/PeriphMap" } },
        "suites": { "type": "array", "items": { "$ref": "#/$defs/TestSuite" } }
      }
    },
    "FwTarget": {
      "type": "object",
      "required": ["id", "mcu", "core", "framework"],
      "properties": {
        "id": { "type": "string" },
        "mcu": { "type": "string" },
        "core": { "type": "string" },
        "memory": { "type": "array", "items": { "type": "object" } },
        "framework": { "enum": ["qmk", "zephyr", "baremetal", "other"] },
        "source_dir": { "type": "string" },
        "build_cmd": { "type": "string" },
        "artifacts": { "type": "array", "items": { "$ref": "#/$defs/Artifact" } }
      }
    },
    "PeriphMap": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "enum": ["uart", "gpio", "i2c", "spi", "usb", "can", "timer", "other"] },
        "base_address": { "type": "integer" },
        "signals": { "type": "array", "items": { "type": "object" } }
      }
    },
    "TestSuite": {
      "type": "object",
      "required": ["id", "path", "framework"],
      "properties": {
        "id": { "type": "string" },
        "path": { "type": "string" },
        "framework": { "type": "string" },
        "last_result": { "type": "object" }
      }
    },
    "Artifact": {
      "type": "object",
      "description": "Shared artifact record (elf/bin/uf2/step/stl/glb/png/repl/resc/csv/json).",
      "required": ["id", "kind", "path", "sha256"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "type": "string" },
        "path": { "type": "string" },
        "sha256": { "type": "string" },
        "bytes": { "type": "integer" },
        "produced_by": { "type": "string" },
        "produced_at": { "type": "string", "format": "date-time" }
      }
    },
    "Simulation": {
      "type": "object",
      "description": "Renode platform/script paths, fault-injection scenarios and captures (owned by plugin-renode).",
      "properties": {
        "_meta": { "$ref": "#/$defs/NodeMeta" },
        "platform": { "type": "object" },
        "scenarios": { "type": "array", "items": { "type": "object" } },
        "captures": { "type": "array", "items": { "type": "object" } }
      }
    },
    "Mechanical": {
      "type": "object",
      "description": "PCB/component bboxes, enclosure and plate/jig params, generated STEP/STL/GLB artifacts (plugin-cad-jig).",
      "properties": {
        "_meta": { "$ref": "#/$defs/NodeMeta" },
        "pcb_bbox": { "type": "object" },
        "component_bboxes": { "type": "array", "items": { "type": "object" } },
        "enclosure": { "type": "object" },
        "plate": { "type": "object" },
        "jig": { "type": "object" },
        "artifacts": { "type": "array", "items": { "$ref": "#/$defs/Artifact" } },
        "checks": { "type": "array", "items": { "$ref": "#/$defs/MechCheck" } }
      }
    },
    "MechCheck": {
      "type": "object",
      "required": ["id", "kind", "status"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "enum": ["collision", "clearance", "pogo_spacing", "cutout"] },
        "status": { "enum": ["pass", "fail"] },
        "detail": { "type": "string" }
      }
    },
    "Sourcing": {
      "type": "object",
      "description": "BOM lines and vendor offers with price breaks, stock and lead times (plugin-sourcing).",
      "properties": {
        "_meta": { "$ref": "#/$defs/NodeMeta" },
        "currency": { "type": "string", "description": "ISO-4217, default USD." },
        "build_qty": { "type": "integer" },
        "budget": { "type": "object" },
        "bom": { "type": "array", "items": { "$ref": "#/$defs/BomLine" } }
      }
    },
    "BomLine": {
      "type": "object",
      "required": ["id", "component_refs", "qty_per_unit"],
      "properties": {
        "id": { "type": "string" },
        "component_refs": { "type": "array", "items": { "type": "string" } },
        "mpn": { "type": "string" },
        "lcsc": { "type": "string" },
        "qty_per_unit": { "type": "integer" },
        "offers": { "type": "array", "items": { "$ref": "#/$defs/Offer" } },
        "chosen_offer_ref": { "type": "string" },
        "alternates": { "type": "array", "items": { "type": "object" } }
      }
    },
    "Offer": {
      "type": "object",
      "required": ["id", "vendor", "sku", "stock", "currency", "fetched_at"],
      "properties": {
        "id": { "type": "string" },
        "vendor": { "enum": ["lcsc", "jlcpcb", "mouser", "digikey", "other"] },
        "sku": { "type": "string" },
        "stock": { "type": "integer" },
        "lead_time_days": { "type": "integer" },
        "moq": { "type": "integer" },
        "price_breaks": { "type": "array", "items": { "type": "object" } },
        "currency": { "type": "string" },
        "fetched_at": { "type": "string", "format": "date-time" },
        "url": { "type": "string" }
      }
    },
    "Fabrication": {
      "type": "object",
      "description": "PCB spec and fab quotes (JLCPCB, …).",
      "properties": {
        "_meta": { "$ref": "#/$defs/NodeMeta" },
        "pcb": { "type": "object" },
        "assembly": { "type": "object" },
        "quotes": { "type": "array", "items": { "type": "object" } }
      }
    },
    "Orders": {
      "type": "object",
      "properties": {
        "_meta": { "$ref": "#/$defs/NodeMeta" },
        "orders": { "type": "array", "items": { "type": "object" } }
      }
    },
    "Gates": {
      "type": "object",
      "description": "Map of gate id (without 'gate:' prefix) to GateResult.",
      "properties": {
        "_meta": { "$ref": "#/$defs/NodeMeta" },
        "results": { "type": "object", "additionalProperties": { "$ref": "#/$defs/GateResult" } }
      }
    },
    "GateResult": {
      "type": "object",
      "required": ["id", "status", "severity", "plugin", "owner_agent", "evaluated_at", "ir_rev"],
      "properties": {
        "id": { "type": "string" },
        "status": { "enum": ["PASS", "FAIL", "SKIP", "ERROR"] },
        "severity": { "enum": ["blocking", "advisory"] },
        "plugin": { "type": "string" },
        "owner_agent": {
          "anyOf": [
            { "enum": ["ee-agent", "fw-agent", "mech-agent", "ops-agent"] },
            { "type": "null" }
          ]
        },
        "evaluated_at": { "type": "string", "format": "date-time" },
        "ir_rev": { "type": "integer" },
        "duration_ms": { "type": "integer" },
        "summary": { "type": "string" },
        "evidence": { "type": "array", "items": { "type": "object" } },
        "suggestions": { "type": "array", "items": { "type": "object" } },
        "refs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "Provenance": {
      "type": "object",
      "description": "DAG node → producer + input/output hashes.",
      "properties": {
        "_meta": { "$ref": "#/$defs/NodeMeta" },
        "nodes": { "type": "object" }
      }
    }
  }
}
