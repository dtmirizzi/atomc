    "contract": "turbo run contract",
    "docs:dev": "pnpm --filter @atomc/docs dev",
    "docs:build": "pnpm --filter @atomc/docs build",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@changesets/cli": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
