{
  "manifest_version": "0.1.0",
  "name": "sourcing",
  "version": "0.1.0",
  "description": "BOM availability and cost sourcing with honest, keyless-first vendor adapters",
  "atomc": ">=0.0.1 <0.2.0",
  "runtime": {
    "python": "atomc_plugin_sourcing:plugin"
  },
  "watches": [
    {
      "id": "sourcing:refresh",
      "ir": ["/sourcing"]
    },
    {
      "id": "fab:quote",
      "ir": ["/layout"]
    }
  ],
  "produces": ["/sourcing", "/fabrication"],
  "gates": [
    {
      "id": "gate:fab.quote_under_budget",
      "severity": "blocking",
      "owner_agent": "ops-agent",
      "after": ["fab:quote"],
      "handler": "check_quote_under_budget"
    }
  ],
  "tools": [
    {
      "name": "query",
      "description": "Query vendor offers for a BOM line, MPN or LCSC part number",
      "input_schema": {
        "type": "object",
        "properties": {
          "bom_line_id": { "type": "string" },
          "mpn": { "type": "string" },
          "lcsc": { "type": "string" },
          "vendors": {
            "type": "array",
            "items": { "enum": ["lcsc", "mouser", "digikey", "nexar"] }
          },
          "force": { "type": "boolean", "default": false },
          "ttl_s": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      },
      "agents": ["ee-agent", "ops-agent"],
      "mutates": false,
      "handler": "query_tool"
    },
    {
      "name": "refresh",
      "description": "Re-query every BOM line and write fresh vendor offers into /sourcing",
      "input_schema": {
        "type": "object",
        "properties": {
          "vendors": {
            "type": "array",
            "items": { "enum": ["lcsc", "mouser", "digikey", "nexar"] }
          },
          "force": { "type": "boolean", "default": false },
          "ttl_s": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      },
      "agents": ["ee-agent", "ops-agent"],
      "mutates": true,
      "handler": "refresh_tool"
    },
    {
      "name": "quote_pcb",
      "description": "Fetch PCB fabrication quotes for a spec and write them into /fabrication; reports honest UNAVAILABLE/ERROR when no quotes can be trusted",
      "input_schema": {
        "type": "object",
        "properties": {
          "pcb": {
            "type": "object",
            "properties": {
              "layers": { "type": "integer", "minimum": 1 },
              "width_mm": { "type": "number", "exclusiveMinimum": 0 },
              "height_mm": { "type": "number", "exclusiveMinimum": 0 },
              "thickness_mm": { "type": "number", "exclusiveMinimum": 0 },
              "finish": { "enum": ["HASL", "LF-HASL", "ENIG"] },
              "color": { "type": "string" },
              "qty": { "type": "integer", "minimum": 1 }
            },
            "required": [
              "layers",
              "width_mm",
              "height_mm",
              "thickness_mm",
              "finish",
              "color",
              "qty"
            ],
            "additionalProperties": false
          },
          "assembly": {
            "type": "object",
            "properties": {
              "side": { "enum": ["top", "bottom", "both"] },
              "parts_count": { "type": "integer", "minimum": 0 }
            },
            "required": ["side", "parts_count"],
            "additionalProperties": false
          },
          "fabs": {
            "type": "array",
            "items": { "enum": ["jlcpcb"] },
            "minItems": 1
          },
          "write": { "type": "boolean", "default": true },
          "force": { "type": "boolean", "default": false }
        },
        "additionalProperties": false
      },
      "agents": ["ops-agent"],
      "mutates": true,
      "handler": "quote_pcb_tool"
    }
  ],
  "cli": [],
  "ui": []
}
